-- Button creator
local function makeButton(parent,text,size,pos)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = GREY
    b.Text = text
    b.TextColor3 = BLACK
    b.TextSize = 18
    b.Font = Enum.Font.GothamBold
    b.Parent = parent
    return b
end

