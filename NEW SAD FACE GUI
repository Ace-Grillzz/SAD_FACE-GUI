-- Category navigation
local function updateCategory()
    categoryLabel.Text = categories[categoryIndex]

    for _,item in ipairs(scroll:GetChildren()) do
        if item:IsA("TextButton") then
            local cat = item:GetAttribute("Category")
            item.Visible =
                categoryIndex == 1 or
                cat == categories[categoryIndex]
        end
    end

    scroll.CanvasPosition = Vector2.new(0,0)
end

left.Activated:Connect(function()
    categoryIndex -= 1
    if categoryIndex < 1 then
        categoryIndex = #categories
    end
    updateCategory()
end)

right.Activated:Connect(function()
    categoryIndex += 1
    if categoryIndex > #categories then
        categoryIndex = 1
    end
    updateCategory()
end)

-- Reopen button declared before Close callback
local open = makeButton(
