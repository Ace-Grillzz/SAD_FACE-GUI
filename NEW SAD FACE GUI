-- Character helper
local function getHumanoid()
    local character = player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

-- Menu button creator
local function addButton(name,category,callback,demo)
    local b = Instance.new("TextButton")
    b.Name = name
    b.BackgroundColor3 = GREY
    b.BorderSizePixel = 0
    b.Text = name
    b.TextColor3 = BLACK
    b.TextSize = 15
    b.TextWrapped = true
    b.Font = Enum.Font.GothamBold
    b.Parent = scroll

    Instance.new("UICorner",b).CornerRadius =
        UDim.new(0,3)

    local enabled = false

    b.Activated:Connect(function()
        if callback then
            callback()
        elseif demo then
            enabled = not enabled
            b.BackgroundColor3 =
                enabled and ACTIVE or GREY
            b.Text = name ..
                (enabled and " [ON]" or " [OFF]")
        end
    end)

    b:SetAttribute("Category",category)
    return b
end

