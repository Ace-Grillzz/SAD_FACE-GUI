local function button(name, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -5, 0, 45)
    b.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = name
    b.Font = Enum.Font.GothamBold
    b.TextSize = 15
    b.Parent = scroll

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    b.Activated:Connect(callback)
    return b
end

local function humanoid()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function toggle(name)
    local enabled = false
    local b

    b = button(name .. " : OFF", function()
        enabled = not enabled
        b.Text = name .. (enabled and " : ON" or " : OFF")
        b.BackgroundColor3 = enabled
            and Color3.fromRGB(0, 120, 160)
            or Color3.fromRGB(30, 40, 60)
    end)
end

toggle("ESP Demo")
toggle("Aimbot Demo")
toggle("Fly Demo")
toggle("Noclip Demo")

button("Speed +5", function()
    local h = humanoid()
    if h then
        h.WalkSpeed = math.clamp(h.WalkSpeed + 5, 16, 50)
    end
end)

button("Jump +10", function()
    local h = humanoid()
    if h then
        h.JumpPower = math.clamp(h.JumpPower + 10, 50, 100)
    end
end)

button("Reset Movement", function()
    local h = humanoid()
    if h then
        h.WalkSpeed = 16
        h.JumpPower = 50
    end
end)

button("CLOSE MENU", function()
    main.Visible = false
    open.Visible = true
end)

open.Activated:Connect(function()
    main.Visible = true
    open.Visible = false
end)

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
        open.Visible = not main.Visible
    end
end)

open.Visible = false
